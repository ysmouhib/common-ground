# Build recipe of the hosting platform this app was scaffolded on. Kept as it was.
#
# WARNING: it copies .env INTO the image, because that platform injects configuration
# as a file. Anyone who can pull an image built this way can read the database URL
# and the AI gateway key. Never push such an image to a registry. For every other
# use, build the default `Dockerfile`, which contains no secret.
FROM node:22-alpine

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000

COPY package.json ./
COPY .env ./
COPY dist ./dist

EXPOSE 3000
CMD ["node", "dist/boot.js"]
