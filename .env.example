# Read by dotenv (npm run dev, npm start) and usable with `docker run --env-file`.
# Keep comments on their own lines: Docker passes everything after "=" as the value.

# ── Database ────────────────────────────────────────────────────
# MySQL connection string: mysql://user:password@host:3306/database
DATABASE_URL=

# ── Review access ───────────────────────────────────────────────
# Without this the deployment is read-only: no review decision, no Lean run, no AI draft.
# At least 24 characters, no spaces. Treat it like a password. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REVIEWER_TOKEN=

# ── Limits and deployment ───────────────────────────────────────
# AI drafts per UTC day for the whole site
AI_DAILY_LIMIT=50
# Number of reverse proxies you run in front of the app (usually 1). Empty = none.
TRUST_PROXY=
# https origins allowed to embed the app in a frame, separated by spaces. Empty = none.
ALLOW_FRAMING_FROM=

# ── Optional AI interpretation checks ───────────────────────────
# Server-side gateway endpoint and credential. Never expose them to the browser.
KIMI_AGENTGW_BASE_URL=
KIMI_AGENTGW_API_KEY=

# ── Optional live Lean verification ─────────────────────────────
# Absolute path to a Lean 4.35.0 executable
LEAN_BIN=
# Limit for one Lean run in milliseconds. Default 60000. The first run after a start is the slowest.
LEAN_TIMEOUT_MS=

# ── Hosting platform ────────────────────────────────────────────
# Set by the platform the app was scaffolded on. Not needed anywhere else.
APP_ID=
APP_SECRET=
