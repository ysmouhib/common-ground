# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Review access ──────────────────────────────────────────────
# Without this the deployment is read-only: no review decision, no Lean run, no AI draft.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REVIEWER_TOKEN=           # At least 24 characters. Treat it like a password.

# ── Limits and deployment ──────────────────────────────────────
AI_DAILY_LIMIT=50         # AI drafts per UTC day for the whole site
TRUST_PROXY=              # Set to 1 only behind a reverse proxy that overwrites X-Forwarded-For
ALLOW_FRAMING_FROM=       # https origins allowed to embed the app in a frame; empty = none

# ── Optional AI interpretation checks ───────────────────────────
KIMI_AGENTGW_BASE_URL=    # Server-side gateway endpoint
KIMI_AGENTGW_API_KEY=     # Server-side gateway credential; never expose to the browser

# ── Optional live Lean verification ─────────────────────────────
LEAN_BIN=                 # Absolute path to a Lean 4.35.0 executable
