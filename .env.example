# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Optional AI interpretation checks ───────────────────────────
KIMI_AGENTGW_BASE_URL=    # Server-side gateway endpoint
KIMI_AGENTGW_API_KEY=     # Server-side gateway credential; never expose to the browser

# ── Optional live Lean verification ─────────────────────────────
LEAN_BIN=                 # Absolute path to a Lean 4.35.0 executable
